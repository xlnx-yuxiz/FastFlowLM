# Configure-time contract: no source mutation, stable output, CRLF portability,
# and fail-closed behavior when the pinned dependency changes.
include("${CMAKE_CURRENT_LIST_DIR}/../../common/chat/xgrammar_string_bounds.cmake")
if(FLM_PATCH_CHILD)
    flm_patch_xgrammar_string_bounds("${FLM_PATCH_INPUT}" "${FLM_PATCH_OUTPUT}")
    return()
endif()
set(original "${CMAKE_CURRENT_LIST_DIR}/../../../third_party/xgrammar/cpp/json_schema_converter.cc")
file(SHA256 "${original}" original_sha)
file(READ "${original}" original_text)
string(REPLACE "\r\n" "\n" normalized "${original_text}")
file(MAKE_DIRECTORY "${FLM_PATCH_TEST_DIR}")
set(output "${FLM_PATCH_TEST_DIR}/patched.cc")
flm_patch_xgrammar_string_bounds("${original}" "${output}")
file(SHA256 "${output}" output_sha)
file(TIMESTAMP "${output}" first_time "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
flm_patch_xgrammar_string_bounds("${original}" "${output}")
file(TIMESTAMP "${output}" second_time "%s")
if(NOT first_time STREQUAL second_time)
    message(FATAL_ERROR "Unchanged configure rewrote patched source")
endif()
string(REPLACE "\n" "\r\n" crlf "${normalized}")
file(WRITE "${FLM_PATCH_TEST_DIR}/crlf.cc" "${crlf}")
flm_patch_xgrammar_string_bounds("${FLM_PATCH_TEST_DIR}/crlf.cc" "${FLM_PATCH_TEST_DIR}/crlf-patched.cc")
file(SHA256 "${FLM_PATCH_TEST_DIR}/crlf-patched.cc" crlf_sha)
if(NOT output_sha STREQUAL crlf_sha)
    message(FATAL_ERROR "CRLF source produced a different patch")
endif()
file(WRITE "${FLM_PATCH_TEST_DIR}/changed.cc" "${normalized}\n// changed dependency\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -DFLM_PATCH_CHILD=ON
    "-DFLM_PATCH_INPUT=${FLM_PATCH_TEST_DIR}/changed.cc"
    "-DFLM_PATCH_OUTPUT=${FLM_PATCH_TEST_DIR}/must-not-exist.cc"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE mismatch_result OUTPUT_VARIABLE mismatch_out ERROR_VARIABLE mismatch_error)
if(mismatch_result EQUAL 0 OR NOT mismatch_error MATCHES "upstream source changed")
    message(FATAL_ERROR "Changed upstream source did not fail at the hash gate: ${mismatch_error}")
endif()
if(EXISTS "${FLM_PATCH_TEST_DIR}/must-not-exist.cc")
    message(FATAL_ERROR "Hash mismatch created an output")
endif()
file(SHA256 "${original}" final_sha)
if(NOT original_sha STREQUAL final_sha)
    message(FATAL_ERROR "Original dependency source was mutated")
endif()
message(STATUS "xgrammar patch contract PASS; generated SHA256=${output_sha}")
